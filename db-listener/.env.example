# ─── db-listener Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in values for local development.
# In Docker, these are provided directly by docker-compose.yml.

# PostgreSQL connection string (must have wal_level=logical enabled)
DATABASE_URL=postgres://pguser:pgpassword@localhost:5432/order_stream

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Redis Stream key used to publish and persist WAL events
REDIS_STREAM_KEY=orders:stream
