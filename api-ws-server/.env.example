# ─── api-ws-server Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in values for local development.
# In Docker, these are provided directly by docker-compose.yml.

# Port for the HTTP and WebSocket server
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgres://pguser:pgpassword@localhost:5432/order_stream

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Redis Stream key to stream database updates and query history (must match REDIS_STREAM_KEY in db-listener)
REDIS_STREAM_KEY=orders:stream
